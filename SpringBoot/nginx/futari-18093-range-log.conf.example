# This log_format belongs in the http context and must be parsed before the test location.
# On the current server, prepend it to /etc/nginx/sites-available/futari.conf because
# nginx.conf loads sites-enabled before conf.d. The test location logs only $uri (no query string).
log_format futari_18093_range
    '$time_iso8601 method=$request_method uri="$uri" status=$status '
    'bytes=$body_bytes_sent request_range="$http_range" '
    'response_range="$sent_http_content_range" '
    'response_length="$sent_http_content_length" '
    'accept_ranges="$sent_http_accept_ranges" '
    'upstream_status="$upstream_status" '
    'upstream_range="$upstream_http_content_range" '
    'upstream_accel="$upstream_http_x_accel_redirect"';
