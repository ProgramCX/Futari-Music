SPRING_PROFILES_ACTIVE=dev
DB_URL=jdbc:mysql://127.0.0.1:3306/futari?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
DB_USER=root
DB_PASSWORD=
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
JWT_SECRET=
JWT_TTL_SECONDS=86400
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NICKNAME=管理员
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_RESET_EXISTING=false
MUSIC_STORAGE_DIR=./music-storage
CORS_ALLOWED_ORIGINS=http://localhost:3000
# 上传限制支持 Spring DataSize 格式（例如 64MB、1GB）；请求上限需大于音频上限并留出封面/歌词空间。
FUTARI_UPLOAD_MAX_AUDIO_SIZE=64MB
FUTARI_UPLOAD_MAX_REQUEST_SIZE=80MB
