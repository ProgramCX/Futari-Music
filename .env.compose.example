# Copy to the repository root as .env before running docker compose.
MYSQL_ROOT_PASSWORD=replace-with-a-unique-root-password
DB_USER=futari
DB_PASSWORD=replace-with-a-unique-database-password
REDIS_PASSWORD=replace-with-a-unique-redis-password
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_TTL_SECONDS=86400
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_NICKNAME=管理员
BOOTSTRAP_ADMIN_PASSWORD=replace-with-an-initial-admin-password
BOOTSTRAP_ADMIN_RESET_EXISTING=false
APP_BIND_ADDRESS=0.0.0.0
APP_PORT=8080
FUTARI_JAR_PATH=./build/futari-server.jar
FUTARI_UPDATE_GITHUB_REPOSITORY=ProgramCX/Futari-Music
FUTARI_UPDATE_POLL_ENABLED=true
FUTARI_UPDATE_POLL_INTERVAL_MS=600000
FUTARI_UPLOAD_MAX_AUDIO_SIZE=64MB
FUTARI_UPLOAD_MAX_REQUEST_SIZE=80MB
